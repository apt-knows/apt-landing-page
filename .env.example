# ------------------------------------------------------------------
# apt landing page — environment variables
# Copy to `.env` for local dev; add the same keys in Vercel →
# Project Settings → Environment Variables for production.
# ------------------------------------------------------------------

# Public (bundled into the client — never put secrets here)
# Absolute origin of the deployed site, no trailing slash.
VITE_SITE_URL="https://apt.app"
# Public contact address shown in the footer / legal pages.
VITE_CONTACT_EMAIL="hello@apt.app"

# Server-only (never exposed to the browser)
# Resend API key — waitlist emails are skipped when this is empty.
RESEND_API_KEY=""
# Verified sender for waitlist email, e.g. "apt <hello@yourdomain.com>".
WAITLIST_FROM_EMAIL="apt <onboarding@resend.dev>"
# Internal inbox that receives a copy of every signup.
WAITLIST_NOTIFY_EMAIL=""
# Optional Resend audience the signup is added to.
RESEND_AUDIENCE_ID=""
# Optional segment identifier tagged on every signup (e.g. "landing-page").
WAITLIST_SEGMENT_ID=""

# Deployment target for the server build (Vercel builds set this for you
# via the `build:vercel` script).
# NITRO_PRESET="vercel"
