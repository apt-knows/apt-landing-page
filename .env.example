# Only the waitlist email integration needs environment configuration. Local
# development works without `.env` and logs signups instead of sending them.
RESEND_API_KEY=""

# Required with RESEND_API_KEY; the domain must be verified in Resend.
WAITLIST_FROM_EMAIL="apt <hello@aptknows.com>"

# Optional notification inbox and Resend audience integration.
WAITLIST_NOTIFY_EMAIL=""
RESEND_AUDIENCE_ID=""
